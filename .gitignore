/target
**/*.rs.bk

# secrets / local env
.env

# Recorded session captures live here; the small curated fixtures under
# fixtures/committed/ are committed explicitly (see below).
/fixtures/*.ndjson

# Runtime match registry — regenerated by the matcher every pass. The annotated
# template config/matches.example.yaml IS committed; a fresh clone recreates
# matches.yaml on first run. Force-add it (git add -f) if you curate manual
# entries you want tracked.
/config/matches.yaml

